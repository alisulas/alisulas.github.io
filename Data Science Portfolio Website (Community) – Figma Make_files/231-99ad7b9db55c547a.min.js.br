`},p={IFRAME:`<button id="showToastButton">Say hello</button>
<button id="closeButton">Close</button>

<script>
  const showToastButton = document.getElementById("showToastButton");
  showToastButton.onclick = () => {
    parent.postMessage({ pluginMessage: { type: "showToast" } }, "*");
  };

  const closeButton = document.getElementById("closeButton");
  closeButton.onclick = () => {
    parent.postMessage({ pluginMessage: { type: "close" } }, "*");
  };
</script>`}},974381:(e,t,n)=>{"use strict";n.d(t,{M_:()=>s,Q9:()=>a,Vv:()=>o,kA:()=>l});var i=n(853039),r=n(342430),a=(e=>(e.ORG_DISABLED="ORG_DISABLED",e.TEAM_NOT_PRO="TEAM_NOT_PRO",e.CANNOT_EDIT_FILE="CANNOT_EDIT_FILE",e.ERROR="ERROR",e))(a||{});function s(e){let{editorType:t,org:n,team:r}=e;return!!("whiteboard"===t&&(n&&n.workshop_enabled||!n&&r&&(0,i.w5)(r)))}function l(e){let{editorType:t,org:n,team:r,canEdit:a}=e;if("whiteboard"!==t);else if(n&&!1===n.workshop_enabled)return"ORG_DISABLED";else if(r&&!(0,i.w5)(r))return"TEAM_NOT_PRO";else if(!1===a)return"CANNOT_EDIT_FILE";return"ERROR"}function o(e,t){localStorage.setItem((0,r.K)(e),t),localStorage.setItem((0,r.H)(),t)}},342430:(e,t,n)=>{"use strict";function i(){return"anonymous-name-prefill"}function r(e){return`anonymous-name-${e}`}n.d(t,{H:()=>i,K:()=>r})},545032:(e,t,n)=>{"use strict";n.d(t,{O:()=>i});let i="Unassigned"},760117:(e,t,n)=>{"use strict";n.d(t,{C:()=>o});var i=n(408825),r=n(944350),a=n(931706);let s=(0,i.fc)(r.bp),l=(0,i.fc)(r.hh),o=i.z.object({actor_user_id:i.z.string().nullish(),assigned_at:i.z.string().nullish(),created_at:i.z.string(),id:i.z.string(),is_main_workspace:i.z.boolean(),org_user_id:i.z.string(),permission:s,update_reason:l.nullish(),updated_at:i.z.string(),uuid:i.z.string(),workspace_id:i.z.string(),idp_group:a.m.nullable().optional(),idp_group_uuid:i.z.string().nullish()})},869450:(e,t,n)=>{"use strict";n.d(t,{D:()=>u});var i=n(776111),r=n(408825),a=n(496670),s=n.n(a);let l=e=>{if(e instanceof r.z.ZodLazy)return l(e.schema);if(e instanceof r.z.ZodEffects)return l(e.innerType());if(e instanceof r.z.ZodLiteral)return[e.value];if(e instanceof r.z.ZodEnum)return e.options;if(e instanceof r.z.ZodNativeEnum)return Object.keys(e.enum);if(e instanceof r.z.ZodDefault)return l(e._def.innerType);if(e instanceof r.z.ZodUndefined)return[void 0];else if(e instanceof r.z.ZodNull)return[null];else return null},o=new Set([r.kY.ZodNullable,r.kY.ZodOptional]);function d(e){return r.z.preproces