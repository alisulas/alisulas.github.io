    html:has(#responsive-scaler) {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
  }
`,R=(0,g.A)`
  @layer figreset {
    :root {
      text-align: left;
      button {
        text-align: left;
      }
    }
  }
